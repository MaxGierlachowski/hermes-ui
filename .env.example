# Hermes UI backend configuration. Copy to .env (git-ignored) or set the variables in the environment;
# CLI flags win over the environment, the environment over .env. Every value below is optional.
# The mobile app has its own build-time settings: mobile-app/.env.example. The web UI needs none.

# ---- Basics ----
# Login token for local browsers. Generated and appended here on the first start if empty.
HERMES_UI_TOKEN=
# Local port; the host is always 127.0.0.1.
HERMES_UI_PORT=8787
# Language of server-generated texts: en | de
HERMES_UI_LANG=en
# Board state, paired devices, iroh identity, inbox, push keys. Default: <repo>/data
HERMES_UI_DATA_DIR=
# Serve the built UI (web/dist) too: on | off (headless, API only)
HERMES_UI_SERVE_UI=on
HERMES_UI_DIR=

# ---- Hermes Agent ----
# Hermes data dir with state.db and gateway.sock. Default: ~/.hermes
HERMES_HOME=
# Extra directories (":"-separated) whose images transcripts may show.
HERMES_UI_IMAGE_ROOTS=

# ---- Remote access ----
# off | iroh (recommended) | tailscale-funnel | tailscale-serve | cloudflare
HERMES_UI_REMOTE=off
# Public URL of the static UI used in pairing links, e.g. https://<you>.github.io/hermes-ui
HERMES_UI_URL=
# Extra origins allowed to call the API with the token (comma separated), e.g. the universal app's web
# dev server http://localhost:8081. The desktop app (tauri://localhost) is always allowed.
HERMES_UI_CORS_ORIGINS=
# iroh-gateway: downloaded and verified on the first start (or: hermes-ui install-gateway).
IROH_GATEWAY_BIN=
IROH_GATEWAY_VERSION=v0.6.3
# Your own iroh relay instead of the public n0 relays.
IROH_RELAY_URL=
IROH_RELAY_TOKEN=
IROH_ADMIN_PORT=
# Tailscale modes only.
TS_AUTHKEY=
TS_HOSTNAME=hermes-ui

# ---- Notifications ----
# Web Push: on | off. VAPID subject (mailto: or https:), default: HERMES_UI_URL if https.
HERMES_UI_PUSH=on
HERMES_UI_PUSH_SUBJECT=
# Firebase service-account JSON for push to the native app (FCM). Keep the file outside the repo.
HERMES_UI_FCM_SERVICE_ACCOUNT=
HERMES_UI_INBOX_DAYS=30
HERMES_UI_INBOX_MAX=1000

# ---- Paseo coding agents (optional) ----
# auto | off
HERMES_UI_PASEO=auto
# auto | mcp | daemon
HERMES_UI_PASEO_SOURCE=auto
HERMES_UI_PASEO_RESPOND=on
PASEO_HOME=
PASEO_MCP_COMMAND=
PASEO_MCP_URL=
PASEO_MCP_TOKEN=
PASEO_MCP_WRITE_TOKEN=
PASEO_MCP_CONFIG=
PASEO_DAEMON_URL=
PASEO_OPS_FILE=
