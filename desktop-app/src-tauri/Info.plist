<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!-- Merged into the app's Info.plist by tauri build. Without the usage texts macOS refuses microphone
     and camera silently (no dialog); they match the phone app's texts (app/app.config.ts). -->
<plist version="1.0">
<dict>
  <key>NSMicrophoneUsageDescription</key>
  <string>Record voice messages for your agent.</string>
  <key>NSCameraUsageDescription</key>
  <string>Take photos for a chat.</string>
</dict>
</plist>
