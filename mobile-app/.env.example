# Build-time configuration of the mobile app (read by app.config.ts; Expo loads .env automatically).
# Copy to .env and fill in what you need. Every value has a working default for local builds.
# .env is git-ignored; do not put secrets here that the app itself must not contain.

# ---- App identity (decide before the first store upload: package / bundle ids are permanent) ----
# Shown under the icon and in the stores' "installed" lists.
HERMES_UI_APP_NAME=Hermes UI
# Reverse-DNS id for both platforms, e.g. com.example.hermesui. Changing it later = a different app
# (users must reinstall; Play/App Store treat it as a new listing).
HERMES_UI_APP_ID=app.hermesui.mobile
# Optional per-platform overrides of HERMES_UI_APP_ID.
HERMES_UI_ANDROID_PACKAGE=
HERMES_UI_IOS_BUNDLE_ID=
# URL scheme for deep links (hermesui://pair?iroh=…). Pairing QR codes of other installs use it too.
HERMES_UI_SCHEME=hermesui

# ---- Pairing links ----
# https pairing links the app offers to open: https://<host><path>/#iroh=…
HERMES_UI_LINK_HOST=maxgierlachowski.github.io
HERMES_UI_LINK_PATH=/hermes-ui
# Verified links (Android App Links / iOS Universal Links) need a domain you control at its root,
# serving .well-known/assetlinks.json and apple-app-site-association (templates in store/templates/).
# Set to the host to turn verification on, e.g. app.example.com. Empty = unverified links.
HERMES_UI_VERIFIED_LINK_HOST=

# ---- Apple ----
# Team ID from developer.apple.com → Membership (10 characters). Needed for device / store builds.
HERMES_UI_APPLE_TEAM_ID=
# Export compliance (Info.plist ITSAppUsesNonExemptEncryption). See docs/releasing.md before changing.
HERMES_UI_IOS_NON_EXEMPT_ENCRYPTION=true

# ---- Expo / EAS (only for EAS builds; local Gradle / Xcode builds need none of this) ----
EAS_PROJECT_ID=
EXPO_OWNER=

# ---- Android ----
# ABIs the iroh library and the APKs are built for (same list for both).
HERMES_UI_ABIS=arm64-v8a,x86_64
# Foreground service type of "Stay connected in the background": dataSync (default; Android 15+ caps
# it at 6 h per 24 h) | remoteMessaging | specialUse. Must match the Play Console declaration.
HERMES_UI_FGS_TYPE=dataSync
# Release keystore properties (default: mobile-app/.secrets/keystore.properties, never committed).
HERMES_UI_KEYSTORE_PROPERTIES=

# ---- Push with the app closed (FCM / APNs through Firebase) ----
# Path to google-services.json of your Firebase project. Without it push stays local-only.
GOOGLE_SERVICES_JSON=
# Path to GoogleService-Info.plist (iOS, only if you use Firebase on iOS).
GOOGLE_SERVICES_PLIST=

# ---- Development ----
# Dev builds only: chats created by automated test runs are marked "TEST · …".
EXPO_PUBLIC_E2E_TEST=
